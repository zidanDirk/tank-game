[Unit]
Description=Tank daily research and small issue planning
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/tank-game
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/ubuntu/.config/tank-research.env
ExecStart=/bin/bash /home/ubuntu/tank-game/scripts/daily-research/run.sh
TimeoutStartSec=3h
UMask=0077
