[Unit]
Description=Implement approved tank issues with MiniMax M3
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=10
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/tank-game
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/ubuntu/.cache/ms-playwright
EnvironmentFile=/home/ubuntu/.config/tank-research.env
ExecStart=/bin/bash /home/ubuntu/tank-game/scripts/issue-implementer/run.sh
TimeoutStartSec=12h
Restart=no
RestartForceExitStatus=75
RestartSec=5h
UMask=0077
